table DisplacementData
	lineageTag: d9c1f7d5-ce73-4107-8898-b6ba5fadfeef

	/// Internally displaced individuals in the current filter context
	measure 'Total IDPs' = SUM(DisplacementData[IDPs])
		formatString: #,0
		lineageTag: a42c105f-8aa0-437d-aaee-00ddf02ffe75

	/// Internally displaced households in the current filter context
	measure 'Total IDP Households' = SUM(DisplacementData[IDP Households])
		formatString: #,0
		lineageTag: bc3df59f-598c-4bea-90cb-f434b4d9dbc5

	/// Returned individuals in the current filter context
	measure 'Total Returned Individuals' = SUM(DisplacementData[Returned Individuals])
		formatString: #,0
		lineageTag: 1602651b-d870-44e8-842f-e6940bb981b5

	/// IDPs plus returned individuals represented by the current filter context
	measure 'People Represented Total' = SUM(DisplacementData[People Represented])
		formatString: #,0
		lineageTag: 73fb7224-b8ef-4341-ae52-7b752bdc2576

	/// Number of localities in the current filter context
	measure 'Locality Count' = DISTINCTCOUNT(DisplacementData[Locality Code])
		formatString: 0
		lineageTag: f51a2871-3837-47c3-b9a2-b3cde89f2eec

	/// Snapshot year in the current filter context
	measure 'Selected Snapshot Year' = MAX(DisplacementData[Snapshot Year])
		formatString: 0
		lineageTag: cd7693de-329b-4a82-ad0b-45386642d8cb

	/// Share of represented people who are returned individuals
	measure 'Returnee Share' = DIVIDE([Total Returned Individuals], [People Represented Total])
		formatString: 0.0%
		lineageTag: fd840610-5891-4c95-9bb9-c65d81c643bf

	/// Locality share of people represented in the current selection
	measure 'Share of Selected People' = DIVIDE([People Represented Total], CALCULATE([People Represented Total], ALLSELECTED(DisplacementData[Locality])))
		formatString: 0.0%
		lineageTag: 5bf32d39-466a-4902-96d4-ca9432222b98

	/// IDP caseload plotted to the left of the pressure fingerprint centreline
	measure 'IDPs Left' = -[Total IDPs]
		formatString: #,0;#,0
		lineageTag: 04df0821-4a24-4c6c-84d7-2780c5755c91

	column Locality
		dataType: string
		lineageTag: c494c48a-d672-4aeb-87c2-a73a53c2aa40
		sourceColumn: Locality

	column 'Locality Code'
		dataType: string
		lineageTag: 373dd0ed-f2af-43d1-bf7c-57e1d3aa2b9a
		sourceColumn: Locality Code

	column 'Snapshot Year'
		dataType: int64
		formatString: 0
		lineageTag: 982c7124-16cf-427a-94c4-db887e018924
		summarizeBy: none
		sourceColumn: Snapshot Year

	column IDPs
		dataType: int64
		formatString: #,0
		lineageTag: d0597778-13b1-4291-8358-070808995225
		summarizeBy: sum
		sourceColumn: IDPs

	column 'IDP Households'
		dataType: int64
		formatString: #,0
		lineageTag: dd0569d7-1ca6-4cae-8e9a-8ea76ee57a02
		summarizeBy: sum
		sourceColumn: IDP Households

	column 'Returned Individuals'
		dataType: int64
		formatString: #,0
		lineageTag: e5f7d5d2-555e-48c4-826b-bedee73468a4
		summarizeBy: sum
		sourceColumn: Returned Individuals

	column 'People Represented'
		dataType: int64
		formatString: #,0
		lineageTag: ce89b43f-c8e2-4198-bacb-ea443fd8248a
		summarizeBy: sum
		sourceColumn: People Represented

	column State
		dataType: string
		lineageTag: 538b962e-0bca-4470-829c-24ff73c3fecc
		sourceColumn: State

	column 'Other People in Need'
		dataType: int64
		formatString: 0
		lineageTag: 7bf4ac7b-f1eb-4d42-9ebe-64d916078456
		summarizeBy: sum
		sourceColumn: Other People in Need

		annotation SummarizationSetBy = Automatic

	partition DisplacementData = m
		mode: import
		source =
				let
					Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/KhalidSaadaldinYahia/sudan-displacement-intelligence/main/project/data/sudan_displacement_state_snapshot.csv"), [Delimiter=",", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(PromotedHeaders, {{"Locality", type text}, {"Locality Code", type text}, {"Snapshot Year", Int64.Type}, {"IDPs", Int64.Type}, {"IDP Households", Int64.Type}, {"Returned Individuals", Int64.Type}, {"People Represented", Int64.Type}, {"State", type text}, {"Other People in Need", Int64.Type}})
				in
					Typed
